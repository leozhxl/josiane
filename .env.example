# ── MERCADO PAGO ────────────────────────────────────────────
MP_ACCESS_TOKEN=
MP_PUBLIC_KEY=

# ── MERCADO LIVRE ────────────────────────────────────────────
ML_APP_ID=
ML_CLIENT_SECRET=
ML_REDIRECT_URI=

# ── KIWIFY (webhook do CRM) ───────────────────────────────────
# Configure a mesma URL + token no painel da Kiwify em
# Configurações > Webhooks: {BASE_URL}/api/kiwify/webhook?token=...
KIWIFY_WEBHOOK_TOKEN=

# ── KIWIFY API (consulta de vendas/pagamentos) ────────────────
# Gere em Kiwify > Configurações > API do desenvolvedor
KIWIFY_CLIENT_ID=
KIWIFY_CLIENT_SECRET=
KIWIFY_ACCOUNT_ID=

# ── E-MAIL (campanhas de marketing do CRM) ───────────────────
# Gmail: SMTP_HOST=smtp.gmail.com, SMTP_PORT=465 e uma "senha de app"
SMTP_HOST=
SMTP_PORT=465
SMTP_USER=
SMTP_PASS=
SMTP_FROM=

# ── BANCO DE DADOS (obrigatório no Vercel) ───────────────────
# O disco do Vercel é somente leitura. Conecte Vercel > Storage >
# Upstash for Redis ao projeto — essas duas variáveis são criadas
# automaticamente. Sem elas, os dados ficam em data/*.json (só local).
KV_REST_API_URL=
KV_REST_API_TOKEN=

# ── GERAL ────────────────────────────────────────────────────
JWT_SECRET=
PORT=3000
BASE_URL=
